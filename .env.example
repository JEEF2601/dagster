# ==============================================================================
# CONFIGURACIÓN DE ENTORNO PARA DAGSTER (ORQUESTADOR)
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (Base de datos interna de Dagster para almacenar runs/events/schedules)
# ------------------------------------------------------------------------------
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster_password_segura
POSTGRES_DB=dagster_db

DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster_password_segura
DAGSTER_POSTGRES_DB=dagster_db
DAGSTER_POSTGRES_HOST=postgres

# Directorio de persistencia interna de Dagster
DAGSTER_HOME=/opt/dagster/dagster_home

# ------------------------------------------------------------------------------
# Conexión Remota a Spark (Spark Connect)
# ------------------------------------------------------------------------------
# Dirección IP privada y puerto del servidor donde corre el Spark Master.
# Reemplazar <IP_PRIVADA_SPARK> con la IP real del servidor de Spark (ej. 192.168.1.50).
SPARK_REMOTE_URL=sc://<IP_PRIVADA_SPARK>:15002

# Paquetes Maven requeridos por PySpark (opcional, descargados en runtime si aplica)
SPARK_PACKAGES=org.apache.hadoop:hadoop-aws:3.4.2

# ------------------------------------------------------------------------------
# Origen de Datos: InfluxDB 1.x
# ------------------------------------------------------------------------------
INFLUXDB_HOST=192.168.1.100
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=homeassistant
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=password_influx
# Ventana de tiempo por defecto para la consulta
INFLUXDB_LOOKBACK=1d
# Consulta InfluxQL personalizada (dejar vacía para usar consulta por defecto)
INFLUXDB_QUERY=

# ------------------------------------------------------------------------------
# Destino: Cloudflare R2 / S3 Storage
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET=tu_bucket_r2
R2_PREFIX=influx/data
R2_REGION=auto
